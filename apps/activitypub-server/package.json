{
  "name": "@red-cup-engineering/activitypub-server",
  "version": "0.1.0",
  "type": "module",
  "description": "The ActivityPub composition root: binds activitypub-services-section's wire forms and pure engine to a live server, purchased storage, and the process environment. The provider, the R2 custody, and the on-chain server -- everything the substrate must not import.",
  "exports": {
    ".": "./src/server.mjs",
    "./local-server": "./src/local-server.mjs",
    "./onchain-server": "./src/onchain-server.mjs",
    "./r2-custody": "./src/r2-custody.mjs",
    "./onchain-r2-external-body": "./src/onchain-r2-external-body.mjs",
    "./publication": "./src/publication.mjs"
  },
  "bin": {
    "serve-activitypub-provider": "./src/server.mjs",
    "serve-local-activitypub-provider": "./src/local-server.mjs",
    "serve-onchain-activitypub-provider": "./src/onchain-server.mjs"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@fedify/vocab": "2.3.1",
    "@red-cup-engineering/activitypub-services-section": "workspace:*",
    "@red-cup-engineering/cloudflare-r2-services-section": "workspace:*",
    "@red-cup-engineering/computer-system-engine": "workspace:*",
    "@red-cup-engineering/computer-web-server": "workspace:*",
    "@red-cup-engineering/cryptographic-computer-data-engineering-services-section": "workspace:*",
    "@red-cup-engineering/javascript-file-services-section": "workspace:*",
    "@red-cup-engineering/json-services-section": "workspace:*"
  },
  "engines": {
    "node": ">=22"
  }
}
