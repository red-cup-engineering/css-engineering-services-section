{
  "name": "@red-cup-engineering/carrier-composition-judgment-service",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Autonomous Actor judging one codomain-domain carrier bond between two morphisms.",
  "exports": {
    ".": "./src/client.mjs",
    "./judgment": "./src/judgment.mjs",
    "./executor": "./src/a2a-executor.mjs"
  },
  "bin": {
    "execute-carrier-composition-judgment-a2a-message": "./scripts/execute-a2a-message.mjs",
    "serve-carrier-composition-judgment-a2a": "./scripts/serve-a2a.mjs"
  },
  "scripts": {
    "check": "node --check src/judgment.mjs && node --check src/a2a-executor.mjs && node --check src/client.mjs && node --check scripts/execute-a2a-message.mjs && node --check scripts/serve-a2a.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.0.0-beta.0",
    "@red-cup-engineering/a2a-contracted-agent-service": "2.0.5",
    "@red-cup-engineering/a2a-rmn-part-service": "1.0.1",
    "@red-cup-engineering/a2a-rmn-task-client-service": "1.1.1",
    "@red-cup-engineering/rmn-semantic-conformance": "6.0.2",
    "@lenticule-science/witness-journal-rdf-projection-service": "1.0.3"
  }
}
