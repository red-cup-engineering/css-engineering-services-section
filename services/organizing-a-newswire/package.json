{
  "name": "@red-cup-engineering/organizing-a-newswire",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Organizing a producing newswire: a single provenanced producing-content claim stream with wire surfaces and bundle state.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "rebuild": "npm run clean && npm run build",
    "verify": "npm run check && npm run build"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "dependencies": {
    "@red-cup-engineering/producing-content": "0.0.2",
    "@red-cup-engineering/relating": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false
}
