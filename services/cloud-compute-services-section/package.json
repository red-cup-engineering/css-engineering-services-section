    "operation-catalog": {
      "forage-improvement-boards": {
        "contract": "ni:///sha-256;hvB0QtxlxnnE05tkJ6J3GDq7HOev1WvjPBwTlvpdRSY",
        "runtimeFiles": [
          "src/client.mjs",
          "src/a2a-executor.mjs",
          "src/improvement-board-forager-service.mjs",
          "src/improvement-board-forager.mjs",
