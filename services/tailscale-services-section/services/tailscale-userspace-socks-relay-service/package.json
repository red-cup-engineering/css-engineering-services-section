{
  "name": "@red-cup-engineering/tailscale-userspace-socks-relay-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bind one loopback TCP listener and relay each connection to one exact tailnet target through a userspace Tailscale SOCKS5 proxy.",
  "bin": {
    "tailscale-userspace-socks-relay": "./src/userspace-socks-relay.mjs"
  },
  "scripts": {
    "check": "node --check src/userspace-socks-relay.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "x-agentic-metro-enterprise": {
    "node-id": "tailscale-userspace-socks-relay-service",
    "organizational-kind": "service",
    "owners": [
      "561-group",
      "red-cup-engineering"
    ],
    "membrane": {
      "law": "src/"
    },
    "admission": "one exact IPv4 RELAY_TARGET_HOST; listens and relays only to that address through the local userspace SOCKS5 proxy",
    "refusal": "tailnet enrollment, auth material custody, DNS, and any target not supplied as one exact IPv4 address",
    "operation-catalog": {
      "relay": {
        "effects": [
          "network"
        ],
        "network": true
      }
    }
  },
  "x-semiotic-voxel": {
    "profile": "org.harmonious-union.semiotic-voxel.v1",
    "owner": "red-cup-engineering",
    "kind": "capability-cell",
    "actor": "urn:ame:tailscale-userspace-socks-relay-service",
    "operations": [
      "relay"
    ],
    "capabilities": [
      {
        "capability": "tailscale-userspace-socks-relay-service",
        "faces": [
          "relay"
        ]
      }
    ],
    "package": "@red-cup-engineering/tailscale-userspace-socks-relay-service"
  }
}
