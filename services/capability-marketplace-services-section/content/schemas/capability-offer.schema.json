{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://red-cup-engineering.github.io/capability-marketplace/schemas/capability-offer.schema.json",
  "title": "Capability Offer projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "semanticId",
    "provider",
    "operation",
    "law",
    "agentCard",
    "authorization",
    "price",
    "expiresAt"
  ],
  "properties": {
    "profile": {"const": "org.emsenn.capability-offer.v1"},
    "semanticId": {"type": "string", "pattern": "^ni:///sha-256;[A-Za-z0-9_-]{43}$"},
    "provider": {"type": "string", "format": "uri"},
    "operation": {"type": "string", "minLength": 1},
    "law": {"type": "string", "pattern": "^ni:///sha-256;[A-Za-z0-9_-]{43}$"},
    "agentCard": {"type": "string", "format": "uri"},
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "grantRequired"],
      "properties": {
        "profile": {"enum": ["OCapN", "none"]},
        "grantRequired": {"type": "boolean"}
      }
    },
    "price": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "asset", "amount", "network"],
      "properties": {
        "protocol": {"const": "x402"},
        "asset": {"type": "string", "minLength": 1},
        "amount": {"type": "string", "pattern": "^[0-9]+$"},
        "network": {"type": "string", "minLength": 1}
      }
    },
    "expiresAt": {"type": "string", "format": "date-time"}
  }
}
