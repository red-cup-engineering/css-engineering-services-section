{
  "name": "@red-cup-engineering/http-edge-service",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "HTTP edge middleware: TLS/ACME, virtual hosting, reverse proxy, rate limiting, CORS, CSRF, sessions, auth, WebSocket upgrade, ESI, and surrogate caching. Sits in front of an @red-cup-engineering/http-server-core-service app.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp/test-dist",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run rebuild",
    "rebuild": "npm run clean && npm run build"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./acme": {
      "types": "./dist/acme.d.mts",
      "import": "./dist/acme.mjs"
    },
    "./auth": {
      "types": "./dist/auth.d.mts",
      "import": "./dist/auth.mjs"
    },
    "./cache": {
      "types": "./dist/cache.d.mts",
      "import": "./dist/cache.mjs"
    },
    "./circuit": {
      "types": "./dist/circuit.d.mts",
      "import": "./dist/circuit.mjs"
    },
    "./cluster": {
      "types": "./dist/cluster.d.mts",
      "import": "./dist/cluster.mjs"
    },
    "./cors": {
      "types": "./dist/cors.d.mts",
      "import": "./dist/cors.mjs"
    },
    "./csrf": {
      "types": "./dist/csrf.d.mts",
      "import": "./dist/csrf.mjs"
    },
    "./esi": {
      "types": "./dist/esi.d.mts",
      "import": "./dist/esi.mjs"
    },
    "./health": {
      "types": "./dist/health.d.mts",
      "import": "./dist/health.mjs"
    },
    "./hints": {
      "types": "./dist/hints.d.mts",
      "import": "./dist/hints.mjs"
    },
    "./hotreload": {
      "types": "./dist/hotreload.d.mts",
      "import": "./dist/hotreload.mjs"
    },
    "./ipfilter": {
      "types": "./dist/ipfilter.d.mts",
      "import": "./dist/ipfilter.mjs"
    },
    "./limits": {
      "types": "./dist/limits.d.mts",
      "import": "./dist/limits.mjs"
    },
    "./proxy": {
      "types": "./dist/proxy.d.mts",
      "import": "./dist/proxy.mjs"
    },
    "./retry": {
      "types": "./dist/retry.d.mts",
      "import": "./dist/retry.mjs"
    },
    "./rewrite": {
      "types": "./dist/rewrite.d.mts",
      "import": "./dist/rewrite.mjs"
    },
    "./security": {
      "types": "./dist/security.d.mts",
      "import": "./dist/security.mjs"
    },
    "./session": {
      "types": "./dist/session.d.mts",
      "import": "./dist/session.mjs"
    },
    "./surrogate": {
      "types": "./dist/surrogate.d.mts",
      "import": "./dist/surrogate.mjs"
    },
    "./tryfiles": {
      "types": "./dist/tryfiles.d.mts",
      "import": "./dist/tryfiles.mjs"
    },
    "./upstream": {
      "types": "./dist/upstream.d.mts",
      "import": "./dist/upstream.mjs"
    },
    "./vhost": {
      "types": "./dist/vhost.d.mts",
      "import": "./dist/vhost.mjs"
    },
    "./ws": {
      "types": "./dist/ws.d.mts",
      "import": "./dist/ws.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@red-cup-engineering/computing-with-http": "0.0.0",
    "@red-cup-engineering/http-server-core-service": "0.0.1",
    "@red-cup-engineering/relating": "0.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.4.1",
    "typescript": "^5.8.0",
    "typescript-eslint": "8.61.0"
  },
  "sideEffects": false
}
