{
  "name": "@red-cup-engineering/http-platform-emulation-service",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Serverless-platform emulation over @red-cup-engineering/http-server-core-service: KV, object storage, durable objects, cron scheduling, feature flags, geo routing, an OpenAPI/validation layer, and a WHATWG fetch-handler adapter.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp/test-dist",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run rebuild",
    "rebuild": "npm run clean && npm run build"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./ab": {
      "types": "./dist/ab.d.mts",
      "import": "./dist/ab.mjs"
    },
    "./cache-api": {
      "types": "./dist/cache-api.d.mts",
      "import": "./dist/cache-api.mjs"
    },
    "./durable": {
      "types": "./dist/durable.d.mts",
      "import": "./dist/durable.mjs"
    },
    "./fetch-adapter": {
      "types": "./dist/fetch-adapter.d.mts",
      "import": "./dist/fetch-adapter.mjs"
    },
    "./fetch": {
      "types": "./dist/fetch.d.mts",
      "import": "./dist/fetch.mjs"
    },
    "./flags": {
      "types": "./dist/flags.d.mts",
      "import": "./dist/flags.mjs"
    },
    "./fs-router": {
      "types": "./dist/fs-router.d.mts",
      "import": "./dist/fs-router.mjs"
    },
    "./geo": {
      "types": "./dist/geo.d.mts",
      "import": "./dist/geo.mjs"
    },
    "./kv": {
      "types": "./dist/kv.d.mts",
      "import": "./dist/kv.mjs"
    },
    "./object-store": {
      "types": "./dist/object-store.d.mts",
      "import": "./dist/object-store.mjs"
    },
    "./openapi": {
      "types": "./dist/openapi.d.mts",
      "import": "./dist/openapi.mjs"
    },
    "./pages": {
      "types": "./dist/pages.d.mts",
      "import": "./dist/pages.mjs"
    },
    "./router": {
      "types": "./dist/router.d.mts",
      "import": "./dist/router.mjs"
    },
    "./scheduler": {
      "types": "./dist/scheduler.d.mts",
      "import": "./dist/scheduler.mjs"
    },
    "./validation": {
      "types": "./dist/validation.d.mts",
      "import": "./dist/validation.mjs"
    },
    "./ws-pubsub": {
      "types": "./dist/ws-pubsub.d.mts",
      "import": "./dist/ws-pubsub.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@red-cup-engineering/computing-with-http": "0.0.0",
    "@red-cup-engineering/http-edge-service": "0.0.1",
    "@red-cup-engineering/http-server-core-service": "0.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.4.1",
    "typescript": "^5.8.0",
    "typescript-eslint": "8.61.0"
  },
  "sideEffects": false
}
