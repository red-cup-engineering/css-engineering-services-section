{
  "name": "@red-cup-engineering/public-https-url-admission-service",
  "version": "0.1.0",
  "description": "Admit one credential-free public HTTPS URL before network use.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/admit-public-https-url.mjs"
  },
  "files": [
    "content/",
    "src/",
    "test/"
  ],
  "scripts": {
    "check": "node --check src/admit-public-https-url.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test && npm pack --dry-run"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/red-cup-engineering/public-https-url-admission-service.git"
  }
}
