{
  "name": "@red-cup-engineering/c2pa-services-section",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Independently hireable C2PA 2.4 provenance and EU AI Act Article 50 disclosure binding service.",
  "exports": {
    ".": {
      "types": "./types/client.d.mts",
      "import": "./src/client.mjs"
    },
    "./client": {
      "types": "./types/client.d.mts",
      "import": "./src/client.mjs"
    },
    "./rmn": "./src/c2pa-rmn.mjs"
  },
  "bin": {
    "serve-c2pa-provenance-a2a": "./scripts/server.mjs"
  },
  "scripts": {
    "check": "node --check src/c2pa-rmn.mjs && node --check src/client.mjs && node --check scripts/execute-a2a-task.mjs && node --check scripts/server.mjs && node --check test/c2pa-provenance.test.mjs",
    "test": "node --test test/c2pa-provenance.test.mjs",
    "verify": "npm run check && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.0.0-beta.0",
    "@contentauth/c2pa-node": "0.6.3",
    "@red-cup-engineering/a2a-agent-card-key-service": "1.0.1",
    "@red-cup-engineering/a2a-contracted-agent-service": "2.0.5",
    "@red-cup-engineering/a2a-rmn-part-service": "1.0.1",
    "@red-cup-engineering/a2a-rmn-task-client-service": "1.1.1",
    "@red-cup-engineering/ethereum-services-section": "0.7.2",
    "@red-cup-engineering/rmn-semantic-conformance": "6.0.2",
    "@lenticule-science/witness-journal-rdf-projection-service": "1.0.3",
    "@lenticule-science/wit-transition-assay": "1.0.1"
  }
}
