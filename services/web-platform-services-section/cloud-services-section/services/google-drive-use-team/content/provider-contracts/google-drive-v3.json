{
  "kind": "external-provider-contract",
  "id": "google-drive-v3-bounded-use",
  "provider": "https://www.googleapis.com/drive/v3",
  "consumer": "urn:ame:google-drive-use-team",
  "operations": {
    "store": { "method": "POST", "path": "/upload/drive/v3/files", "maximumRequests": 1 },
    "retrieve": { "method": "GET", "path": "/drive/v3/files/{fileId}", "maximumRequests": 2 },
    "list": { "method": "GET", "path": "/drive/v3/files", "maximumRequests": 1 }
  },
  "credentialCustody": "customer-or-customer-appointed-custodian",
  "credentialRecorded": false,
  "retry": false,
  "fallback": false,
  "priceClaim": "unknown-not-zero",
  "liveCapacityClaim": false
}
