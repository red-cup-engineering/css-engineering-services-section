[Unit]
Description=Zelo command-only Discord response canary (disabled until operator activation)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/emsenn/services/zelo-command-canary/current
Environment=NODE_ENV=production
Environment=PATH=/home/emsenn/.nvm/versions/node/v24.16.0/bin:/usr/local/bin:/usr/bin:/bin
# This file is created and protected on-host. It is not committed.
EnvironmentFile=/home/emsenn/services/zelo-command-canary/runtime.env
ExecStart=/home/emsenn/.nvm/versions/node/v24.16.0/bin/node src/canary-entrypoint.mjs
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/home/emsenn/services/zelo-command-canary/state

[Install]
# Do not enable this unit as part of installation. Enabling requires the canary acceptance runbook.
WantedBy=default.target
