# Copy to the on-host runtime.env with mode 0600. Keep ZELO_CANARY_MODE=disabled
# until the exact-command acceptance steps in CANARY-RUNBOOK.md are complete.
ZELO_CANARY_MODE=disabled
ZELO_CANARY_CONFIG_FILE=/home/emsenn/services/zelo-command-canary/config/programmable-response.json
ZELO_CANARY_RECEIPT_FILE=/home/emsenn/services/zelo-command-canary/state/response-receipts.json
ZELO_CANARY_LEASE_FILE=/home/emsenn/services/zelo-command-canary/state/process-lease.json
ZELO_CANARY_INGRESS_SECRET_FILE=/home/emsenn/services/zelo-command-canary/secrets/ingress-hmac.bin
ZELO_DISCORD_BOT_TOKEN_FILE=/home/emsenn/services/zelo-command-canary/secrets/discord-bot-token
ZELO_CANARY_LISTEN_HOST=127.0.0.1
ZELO_CANARY_LISTEN_PORT=18186
