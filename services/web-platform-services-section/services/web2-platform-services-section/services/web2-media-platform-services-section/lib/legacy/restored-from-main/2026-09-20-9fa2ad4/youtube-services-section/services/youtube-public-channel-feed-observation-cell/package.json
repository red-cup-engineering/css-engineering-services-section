{
  "name": "@red-cup-engineering/youtube-public-channel-feed-observation-cell",
  "version": "0.1.7",
  "description": "One autonomous actor that observes one immutable YouTube channel's public Atom feed.",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "serve-youtube-public-channel-feed-observation": "./scripts/server.mjs"
  },
  "exports": {
    ".": "./lib/observe.mjs",
    "./protocol": "./src/protocol.mjs"
  },
  "scripts": {
    "check": "for file in lib/*.mjs src/*.mjs scripts/*.mjs test/*.test.mjs; do node --check \"$file\" || exit; done",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@red-cup-engineering/semantic-content-identify-service": "0.2.7",
    "@a2a-js/sdk": "1.0.0-beta.0",
    "@red-cup-engineering/a2a-agent-card-key-service": "0.4.0",
    "@red-cup-engineering/a2a-contracted-agent-service": "0.5.0",
    "@red-cup-engineering/a2a-sovereign-operation-boundary-service": "0.3.0",
    "@red-cup-engineering/semantic-record-journal-service": "0.4.0"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "content"
  ]
}
