{
  "name": "@emsweb/channel-analytics-interpretation-broker",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Same-principal, purpose-bound interpretation of exact channel-owned audience observations without raw-data title or credentials.",
  "scripts": {
    "check": "for file in src/*.mjs test/*.test.mjs; do node --check \"$file\" || exit; done",
    "process-commission": "node src/process-commission.mjs",
    "serve-commission-processing": "node src/serve-commission-processing-a2a.mjs",
    "serve-curiosity-offer": "node src/serve-curiosity-offer-a2a.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@red-cup-engineering/a2a-agent-card-discovery-service": "1.0.1",
    "@red-cup-engineering/a2a-agent-card-key-service": "1.0.1",
    "@red-cup-engineering/a2a-contracted-agent-service": "2.0.5",
    "@red-cup-engineering/a2a-rmn-part-service": "1.0.1",
    "@red-cup-engineering/a2a-rmn-task-client-service": "1.1.1",
    "@red-cup-engineering/semantic-content-identify-service": "0.2.2",
    "@red-cup-engineering/witness-journal-rdf-projection-service": "1.1.0"
  },
  "keywords": [
    "sovereign-state-enterprise",
    "analytics",
    "broker"
  ],
  "license": "UNLICENSED"
}
