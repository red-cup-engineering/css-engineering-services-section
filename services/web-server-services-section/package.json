{
  "name": "@red-cup-engineering/http-server",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "description": "Compatibility shim over the split http-services-section packages (core, edge, platform-emulation, observability) and mesh-networking-service. Its dist/ predates the split and stays as it was built; its src/ now only re-exports so a future rebuild would delegate correctly.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp/test-dist",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run rebuild",
    "rebuild": "npm run clean && npm run build"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./server": {
      "types": "./dist/server/index.d.mts",
      "import": "./dist/server/index.mjs"
    },
    "./edge": {
      "types": "./dist/server/edge/index.d.mts",
      "import": "./dist/server/edge/index.mjs"
    },
    "./mesh": {
      "types": "./dist/server/mesh/index.d.mts",
      "import": "./dist/server/mesh/index.mjs"
    },
    "./platform": {
      "types": "./dist/server/platform/index.d.mts",
      "import": "./dist/server/platform/index.mjs"
    },
    "./observability": {
      "types": "./dist/server/observability/index.d.mts",
      "import": "./dist/server/observability/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@red-cup-engineering/http-edge-service": "0.0.1",
    "@red-cup-engineering/http-observability-service": "0.0.1",
    "@red-cup-engineering/http-platform-emulation-service": "0.0.1",
    "@red-cup-engineering/http-server-core-service": "0.0.1",
    "@red-cup-engineering/mesh-networking-service": "0.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.4.1",
    "typescript": "^5.8.0",
    "typescript-eslint": "8.61.0"
  },
  "sideEffects": false
}
