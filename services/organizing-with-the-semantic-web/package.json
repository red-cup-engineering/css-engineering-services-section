{
  "name": "@red-cup-engineering/organizing-with-the-semantic-web",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "description": "Organizing with the semantic web: linked data, RDF/Turtle/JSON-LD, Linked Data Fragments, semantic reading, hypertext projection, microformats, page metadata, taxonomy, Cool URIs, and semantic site surfaces downstream of organizing.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp/test-dist",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run rebuild",
    "rebuild": "npm run clean && npm run build"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./linked-data": {
      "types": "./dist/linked-data/index.d.mts",
      "import": "./dist/linked-data/index.mjs"
    },
    "./triple-pattern-fragments": {
      "types": "./dist/triple-pattern-fragments/index.d.mts",
      "import": "./dist/triple-pattern-fragments/index.mjs"
    },
    "./semantic-reader": {
      "types": "./dist/semantic-reader/index.d.mts",
      "import": "./dist/semantic-reader/index.mjs"
    },
    "./semantic-hypertext": {
      "types": "./dist/semantic-hypertext/index.d.mts",
      "import": "./dist/semantic-hypertext/index.mjs"
    },
    "./semantic-site-server": {
      "types": "./dist/semantic-site-server/index.d.mts",
      "import": "./dist/semantic-site-server/index.mjs"
    },
    "./page-metadata": {
      "types": "./dist/page-metadata/index.d.mts",
      "import": "./dist/page-metadata/index.mjs"
    },
    "./taxonomy": {
      "types": "./dist/taxonomy/index.d.mts",
      "import": "./dist/taxonomy/index.mjs"
    },
    "./microformats": {
      "types": "./dist/microformats/index.d.mts",
      "import": "./dist/microformats/index.mjs"
    },
    "./cool-uris": {
      "types": "./dist/cool-uris/index.d.mts",
      "import": "./dist/cool-uris/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@red-cup-engineering/markdown-file-codec-service": "0.1.0",
    "@red-cup-engineering/markdown-file-reading-service": "0.1.0",
    "@red-cup-engineering/html-file-codec-service": "0.1.2",
    "@red-cup-engineering/xml-file-codec-service": "0.1.2",
    "@red-cup-engineering/animating": "0.0.2",
    "@red-cup-engineering/knowing": "0.0.1",
    "@red-cup-engineering/producing-content": "0.0.2",
    "@red-cup-engineering/relating": "0.0.1",
    "@red-cup-engineering/organizing-with-the-web": "0.0.3",
    "@red-cup-engineering/http-server": "0.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.4.1",
    "typescript": "^5.8.0",
    "typescript-eslint": "8.61.0"
  },
  "sideEffects": false,
  "keywords": [
    "decommissioned"
  ]
}
