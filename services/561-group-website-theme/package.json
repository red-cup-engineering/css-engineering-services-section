{
  "name": "@red-cup-engineering/561-group-website-theme",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "keywords": [
    "decommissioned",
    "triage"
  ],
  "description": "561 Group visual identity as a web-theming Theme. Implements the design bible: bone/ink palette, type scale, 12-column grid.",
  "scripts": {
    "clean": "rm -rf dist .tmp/test-dist",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run rebuild",
    "rebuild": "npm run clean && npm run build"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@red-cup-engineering/organizing-with-the-web": "0.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "sideEffects": false,
  "x-semiotic-voxel": {
    "profile": "org.harmonious-union.semiotic-voxel.v1",
    "owner": "red-cup-engineering",
    "kind": "inert-material",
    "actor": "urn:ame:561-group-website-theme",
    "operations": [],
    "capabilities": [],
    "package": "@red-cup-engineering/561-group-website-theme"
  }
}
