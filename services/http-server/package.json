{
  "name": "@red-cup-engineering/http-server",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "description": "HTTP server computing service library: application types, response representations, routing composition, middleware, Node server startup, and HTTP edge/platform helpers.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp/test-dist",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run rebuild",
    "rebuild": "npm run clean && npm run build"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./server": {
      "types": "./dist/server/index.d.mts",
      "import": "./dist/server/index.mjs"
    },
    "./edge": {
      "types": "./dist/server/edge/index.d.mts",
      "import": "./dist/server/edge/index.mjs"
    },
    "./mesh": {
      "types": "./dist/server/mesh/index.d.mts",
      "import": "./dist/server/mesh/index.mjs"
    },
    "./platform": {
      "types": "./dist/server/platform/index.d.mts",
      "import": "./dist/server/platform/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@red-cup-engineering/animating": "0.0.2",
    "@red-cup-engineering/computing-with-http": "0.0.0",
    "@red-cup-engineering/relating": "0.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.4.1",
    "typescript": "^5.8.0",
    "typescript-eslint": "8.61.0"
  },
  "sideEffects": false,
  "x-semiotic-voxel": {
    "profile": "org.harmonious-union.semiotic-voxel.v1",
    "owner": "red-cup-engineering",
    "kind": "inert-material",
    "actor": "urn:ame:http-server",
    "operations": [],
    "capabilities": [],
    "package": "@red-cup-engineering/http-server"
  }
}
