{
  "name": "@red-cup-engineering/gaming",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "keywords": [
    "relational-computing",
    "relational-computing-kernel"
  ],
  "description": "Gaming — concurrent game systems (CGS) operationalized as one package downstream of animating and upstream of computing: algebra carriers (Player/Opponent polarity, polarized prime event structures, strategies, ludics loci and designs, interaction as the knowledge-join), topology closure/settling, linear-logic proof, causal/spatial geometry, dynamics analysis, operational game computers, and charge-faithful codecs. Each former game-* package is now a module subpath. A game is a configuration of animating handedness over the relating substrate.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp",
    "check": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.scripts.json && node copy-dist-assets.mjs && chmod +x dist/scripts/*.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "verify": "npm run check && npm run build",
    "rebuild": "npm run clean && npm run build",
    "examples": "node examples/multi-agent-arena.mjs"
  },
  "bin": {
    "gaming": "./dist/scripts/cli.mjs",
    "gaming-serve": "./dist/scripts/serve.mjs"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./structuring": {
      "types": "./dist/structuring/index.d.mts",
      "import": "./dist/structuring/index.mjs"
    },
    "./encoding": {
      "types": "./dist/encoding/index.d.mts",
      "import": "./dist/encoding/index.mjs"
    },
    "./running": {
      "types": "./dist/running/index.d.mts",
      "import": "./dist/running/index.mjs"
    },
    "./market": {
      "types": "./dist/market/index.d.mts",
      "import": "./dist/market/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@red-cup-engineering/relating": "0.0.0",
    "@red-cup-engineering/animating": "0.0.0",
    "@red-cup-engineering/communicating": "0.0.0",
    "@red-cup-engineering/playing": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "sideEffects": false,
  "x-semiotic-voxel": {
    "profile": "org.harmonious-union.semiotic-voxel.v1",
    "owner": "red-cup-engineering",
    "kind": "capability-cell",
    "actor": "urn:ame:gaming",
    "operations": [
      "gaming"
    ],
    "capabilities": [
      {
        "capability": "gaming",
        "faces": [
          "gaming"
        ]
      }
    ],
    "package": "@red-cup-engineering/gaming"
  }
}
