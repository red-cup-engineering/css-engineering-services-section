module A2ASovereignOperationBoundary

sort Request
sort Response
sort Runtime
sort Refusal
sort OperationName

relation canonicalRequest : Request
relation roleUser : Request
relation admittedOperation : Request * OperationName
relation activeRuntime : OperationName * Runtime
relation executed : Request * Runtime * Response
relation refused : Request * Refusal
relation returned : Request * Response

rule returnExecuted(request, operation, runtime, response):
  canonicalRequest(request)
  and roleUser(request)
  and admittedOperation(request, operation)
  and activeRuntime(operation, runtime)
  and executed(request, runtime, response)
  -> returned(request, response)

require noUnknownOperationExecution(request):
  not (exists operation, runtime, response .
    canonicalRequest(request)
    and not admittedOperation(request, operation)
    and executed(request, runtime, response))

require noInactiveRuntimeExecution(request, operation):
  not (exists runtime, response .
    admittedOperation(request, operation)
    and not activeRuntime(operation, runtime)
    and executed(request, runtime, response))

require refusalHasNoExecution(request, refusal):
  refused(request, refusal)
  -> not (exists runtime, response . executed(request, runtime, response))
