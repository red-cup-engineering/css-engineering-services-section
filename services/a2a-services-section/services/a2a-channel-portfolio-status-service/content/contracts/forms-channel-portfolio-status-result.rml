#lang rmn/v2
(map
  ("type" "FormsChannelPortfolioStatusResultLaw")
  ("version" 1)
  ("provider" "urn:ame:a2a-contracted-agent-service")
  ("precondition" "A sovereign channel supplies its own actor, one exact canonical ChannelPortfolioStatusRequest addressed by the emsWeb Video Federation, and a bounded callback that reads only that channel's local status records.")
  ("operation" "Validate canonical request identity and scope, ask the channel callback for the exact civil-day status, validate its canonical identity and channel binding, and wrap it as one canonical RMN A2A Accept result.")
  ("postcondition" "The result binds the exact request identity, channel actor, federation target, civil day and status object. The protocol provider retains no status or credential.")
  ("refusal" "Refuse noncanonical RMN, foreign federation or channel, invalid civil day or timezone, changed status identity, status-channel or day mismatch, multiple parts, credentials, writes, dispatch, scheduling, publication, settlement, or ambient channel-data access.")
  ("authorityWithheld" (array "channel-data-custody" "channel-credentials" "channel-write" "dispatch" "scheduling" "publication" "settlement")))
