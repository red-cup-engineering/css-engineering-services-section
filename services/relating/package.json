{
  "name": "@red-cup-engineering/relating",
  "version": "0.1.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "keywords": [
    "relational-computing",
    "relational-computing-kernel"
  ],
  "description": "Relating: one boundary system where actions project to CLI, HTTP, OpenAPI, MCP, and docs from one registry, and each carrier is one JSON-Schema literal interpreted by FromSchema and the runtime validator.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.services.json && node copy-dist-assets.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "examples": "node examples/material/camera-exposure.mjs",
    "verify": "npm run check && npm run build && npm test && npm run examples",
    "docs:api": "typedoc",
    "prepack": "npm run rebuild",
    "rebuild": "npm run clean && npm run build"
  },
  "main": "./dist/src/index.mjs",
  "types": "./dist/src/index.d.mts",
  "files": [
    "dist",
    "docs",
    "examples",
    "LICENSE",
    "README.md",
    "typedoc.json",
    "package.json"
  ],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "fast-check": "^4.8.0",
    "typedoc": "^0.28.19",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@lenticule-science/articulating": "0.2.0",
    "@red-cup-engineering/content-tree-reading-service": "0.1.0",
    "@red-cup-engineering/file-cryptographic-integrity-service": "0.1.1",
    "@red-cup-engineering/file-projection-kernel-service": "0.1.1",
    "@red-cup-engineering/html-file-codec-service": "0.1.2",
    "@red-cup-engineering/json-file-codec-service": "0.1.3",
    "@red-cup-engineering/json-schema-services-section": "0.1.3",
    "@red-cup-engineering/markdown-file-codec-service": "0.1.2",
    "@red-cup-engineering/relation-model-notation": "0.0.1",
    "@red-cup-engineering/relation-model-notation-eval": "0.0.2",
    "@red-cup-engineering/relation-model-notation-typing": "0.0.1",
    "@red-cup-engineering/wire-form-round-trip-check": "0.0.1",
    "@red-cup-engineering/witness-journal-coherence": "0.0.1",
    "@red-cup-engineering/xml-file-codec-service": "0.1.2"
  },
  "overrides": {
    "@red-cup-engineering/toml-file-codec-service": "0.1.1"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.mts",
      "import": "./dist/src/index.mjs"
    },
