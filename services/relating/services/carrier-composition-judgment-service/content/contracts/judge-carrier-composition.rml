#lang rmn/v2
(map
  ("type" "CapabilityLaw")
  ("version" 1)
  ("provider" "urn:ame:carrier-composition-judgment-service")
  ("operation" "judge-carrier-composition")
  ("precondition" "Receive one exact provider-addressed canonical RMN operation carrying a producer morphism face and consumer morphism face.")
  ("effect" "Compare only the producer codomain carrier identity with the consumer domain carrier identity.")
  ("postcondition" "Return a typed witness at the shared carrier locus exactly when the identities coincide; otherwise return a typed missing-side or mismatch obstruction.")
  ("refusal" "Never execute either morphism, search for alternate carriers, plan a workflow, mutate a registry, or infer identity from verb names, schemas, codecs, or descriptions."))
