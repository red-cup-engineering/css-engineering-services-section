#lang rmn/v2
(map
  ("type" "YouTubePublicChannelFeedObservationLaw")
  ("version" 1)
  ("provider" "urn:ame:youtube-public-channel-feed-observation-cell")
  ("precondition" "The customer supplies one canonical request naming one immutable UC-prefixed YouTube channel ID.")
  ("operation" "Fetch exactly that channel's public YouTube Atom feed without credentials or redirects, require the returned feed to bind the same immutable channel ID, and project its public title plus optional latest public entry into canonical RMN.")
  ("postcondition" "Return one content-addressed public-feed observation and append the exact result through the hired RWIL/RDF provider.")
  ("refusal" "Refuse credentials, API keys, private state, search, ranking, interpretation, analytics, publication, scheduling, channel writes, redirects, oversized or malformed XML, non-YouTube origins, or a returned channel identity different from the request."))

