{
  "name": "@red-cup-engineering/youtube-public-channel-feed-observation-cell",
  "version": "0.1.0",
  "description": "One autonomous actor that observes one immutable YouTube channel's public Atom feed.",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "bin": {
    "serve-youtube-public-channel-feed-observation": "./bin/server.mjs"
  },
  "exports": {
    ".": "./lib/observe.mjs",
    "./protocol": "./src/protocol.mjs"
  },
  "scripts": {
    "check": "for file in lib/*.mjs src/*.mjs bin/*.mjs test/*.test.mjs; do node --check \"$file\" || exit; done",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.0.0-beta.0",
    "@red-cup-engineering/a2a-agent-card-key-service": "1.0.0",
    "@red-cup-engineering/a2a-contracted-agent-service": "2.0.4",
    "@red-cup-engineering/a2a-sovereign-operation-boundary-service": "1.0.0",
    "@red-cup-engineering/rmn-semantic-conformance": "6.0.1",
    "@lenticule-science/rwil-rdf-projection-service": "1.0.2"
  }
}
