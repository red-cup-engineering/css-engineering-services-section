{
  "name": "@red-cup-engineering/youtube-public-channel-feed-observation-cell",
  "version": "0.1.0",
  "description": "One autonomous actor that observes one immutable YouTube channel's public Atom feed.",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "bin": {
    "serve-youtube-public-channel-feed-observation": "./bin/server.mjs"
  },
  "exports": {
    ".": "./lib/observe.mjs",
    "./protocol": "./src/protocol.mjs"
  },
  "scripts": {
    "check": "for file in lib/*.mjs src/*.mjs bin/*.mjs test/*.test.mjs; do node --check \"$file\" || exit; done",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.0.0-beta.0",
    "@red-cup-engineering/a2a-agent-card-key-service": "1.0.0",
    "@red-cup-engineering/a2a-contracted-agent-service": "2.0.4",
    "@red-cup-engineering/a2a-sovereign-operation-boundary-service": "1.0.0",
    "@red-cup-engineering/rmn-semantic-conformance": "6.0.0",
    "@lenticule-science/rwil-rdf-projection-service": "1.0.2"
  },
  "x-agentic-metro-enterprise": {
    "node-id": "youtube-public-channel-feed-observation-cell",
    "actor": "urn:ame:youtube-public-channel-feed-observation-cell",
    "organizational-kind": "capability-cell",
    "owners": [
      "youtube-services-section"
    ],
    "membrane": {
      "law": "lib/",
      "lasting-instances": "content/",
      "append-only-instances": "data/"
    },
    "admission": "one canonical RMN request naming one immutable YouTube channel ID",
    "refusal": "credentials, private state, analytics, search, ranking, interpretation, publication, scheduling, channel writes, redirects, non-YouTube feed origins, malformed XML, or changed channel identity",
    "operation-catalog": {
      "observe-youtube-public-channel-feed": {
        "lawSource": "content/contracts/observe-youtube-public-channel-feed.rml",
        "protocol": "A2A 1.0",
        "input": "application/rmn+cbor",
        "output": "application/rmn+cbor",
        "externalVenue": "https://www.youtube.com/feeds/videos.xml",
        "legacyCompatibility": false
      }
    }
  },
  "x-semiotic-voxel": {
    "profile": "org.harmonious-union.semiotic-voxel.v1",
    "owner": "red-cup-engineering",
    "kind": "capability-cell",
    "actor": "urn:ame:youtube-public-channel-feed-observation-cell",
    "operations": [
      "observe-youtube-public-channel-feed"
    ],
    "capabilities": [
      {
        "capability": "youtube-public-channel-feed-observation-cell",
        "faces": [
          "observe-youtube-public-channel-feed"
        ]
      }
    ],
    "package": "@red-cup-engineering/youtube-public-channel-feed-observation-cell"
  }
}
