#lang rmn/v2
(map
  ("type" "YoutubeDataApiProtocolOperationLaw")
  ("version" 2)
  ("provider" "urn:ame:youtube-services-section")
  ("precondition" "A sovereign customer supplies one bounded operation, exact non-secret request terms, and an attenuated authorizedFetch capability which adds authorization inside customer territory without disclosing credential material to the provider.")
  ("operation" "Construct the exact Google endpoint, headers excluding authorization, and bounded body; invoke the customer capability where authorization is required; validate status, response shape, resumable upload origin, privacy semantics, returned venue identifiers, and exact single-video observation identity; return the protocol result to the customer without recording customer territory.")
  ("postcondition" "The customer receives a bounded protocol result or typed refusal. Private-draft video operations omit publishAt. A video observation reports only Google venue state and never itself attests customer publication. The provider has no channel authority, credential, customer receipt, calendar claim, editorial acceptance, or publication attestation.")
  ("refusal" "Refuse credentials or authorization headers as data, missing authorized capability, malformed or oversized metadata, unsafe upload origins, redirecting or non-HTTPS venue carriers, private drafts carrying publishAt, scheduled publication without an exact instant, malformed or non-singleton venue responses, changed observed video identity, or any request for customer-territory writes or acceptance.")
  ("protocol" "YouTube-Data-API-v3")
  ("evidence" "provider-result-returned-to-customer"))
