{
  "name": "@red-cup-engineering/web-server",
  "version": "0.3.0",
  "type": "module",
  "description": "The Fetch and Node HTTP runtime over one computer platform: request dispatch, provider lifetime, streamed response drain and Workers bindings.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./node": {
      "types": "./dist/node.d.mts",
      "import": "./dist/node.mjs"
    },
    "./package.json": "./package.json",
    "./workers": {
      "types": "./dist/workers.d.mts",
      "import": "./dist/workers.mjs"
    }
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "check": "tsc -p tsconfig.build.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test test/*.test.mts",
    "prepack": "npm run clean && npm run build"
  },
  "dependencies": {
    "@red-cup-engineering/http-server-application-contract-service": "0.9.0",
    "@red-cup-engineering/web-server-services-section": "0.5.0",
    "@red-cup-engineering/computer-platform": "0.5.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  },
  "sideEffects": false
}
