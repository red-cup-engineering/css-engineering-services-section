{
  "name": "@red-cup-engineering/web-application",
  "version": "0.3.0",
  "type": "module",
  "description": "Application resource composition, bounded request intake, schema validation and OpenAPI on the shared web server.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "check": "tsc -p tsconfig.build.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test test/*.test.mts",
    "prepack": "npm run clean && npm run build"
  },
  "dependencies": {
    "@red-cup-engineering/http-server-application-contract-service": "0.9.0",
    "@red-cup-engineering/read-http-request-body-service": "0.2.2",
    "@red-cup-engineering/web-server-services-section": "0.5.0",
    "@red-cup-engineering/web-server": "0.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  },
  "sideEffects": false
}
