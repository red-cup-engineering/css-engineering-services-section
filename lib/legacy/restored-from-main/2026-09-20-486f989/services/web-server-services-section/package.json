{
  "name": "@red-cup-engineering/web-server-services-section",
  "version": "0.5.0",
  "type": "module",
  "description": "Owns the pure operations that serve Web applications: the transport-neutral request dispatch pipeline, route admission, response policy (CORS, cache, security headers), request traces, input validation, OpenAPI projection, static files, SSE hubs, the Node HTTP transport and its lifecycle, and the Node/WHATWG stream bridge. The web-server, web-platform, and web-application apps compose these; this section holds no engine of its own.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp/test-dist",
    "check": "tsc -p tsconfig.build.json --noEmit",
    "test": "node --test test/*.test.mts",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run rebuild",
    "rebuild": "npm run clean && npm run build"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./admission": {
      "types": "./dist/admission.d.mts",
      "import": "./dist/admission.mjs"
    },
    "./compress": {
      "types": "./dist/compress.d.mts",
      "import": "./dist/compress.mjs"
    },
    "./cookies": {
      "types": "./dist/cookies.d.mts",
      "import": "./dist/cookies.mjs"
    },
    "./http": {
      "types": "./dist/http.d.mts",
      "import": "./dist/http.mjs"
    },
    "./mount-app": {
      "types": "./dist/mount-app.d.mts",
      "import": "./dist/mount-app.mjs"
    },
    "./pipeline": {
      "types": "./dist/pipeline.d.mts",
      "import": "./dist/pipeline.mjs"
    },
    "./problem": {
      "types": "./dist/problem.d.mts",
      "import": "./dist/problem.mjs"
    },
    "./request": {
      "types": "./dist/request.d.mts",
      "import": "./dist/request.mjs"
    },
    "./route-admission": {
      "types": "./dist/route-admission.d.mts",
      "import": "./dist/route-admission.mjs"
    },
    "./serve-scripts": {
      "types": "./dist/serve-scripts.d.mts",
      "import": "./dist/serve-scripts.mjs"
    },
    "./sse": {
      "types": "./dist/sse.d.mts",
      "import": "./dist/sse.mjs"
    },
    "./static": {
      "types": "./dist/static.d.mts",
      "import": "./dist/static.mjs"
    },
    "./internal/*": {
      "types": "./dist/internal/*.d.mts",
      "import": "./dist/internal/*.mjs"
    },
    "./package.json": "./package.json",
    "./web-bridge": {
      "types": "./dist/internal/web-bridge.d.mts",
      "import": "./dist/internal/web-bridge.mjs"
    },
    "./node": {
      "types": "./dist/node.d.mts",
      "import": "./dist/node.mjs"
    },
    "./validation": {
      "types": "./dist/validation.d.mts",
      "import": "./dist/validation.mjs"
    },
    "./openapi": {
      "types": "./dist/openapi.d.mts",
      "import": "./dist/openapi.mjs"
    },
    "./application": {
      "types": "./dist/application.d.mts",
      "import": "./dist/application.mjs"
    },
    "./native-application": {
      "types": "./dist/native-application.d.mts",
      "import": "./dist/native-application.mjs"
    },
    "./response-policy": {
      "types": "./dist/response-policy.d.mts",
      "import": "./dist/response-policy.mjs"
    }
  },
  "dependencies": {
    "@lenticule-science/articulating": "0.5.1",
    "@red-cup-engineering/classify-http-media-type-service": "0.1.1",
    "@red-cup-engineering/code-http-byte-range-service": "0.1.1",
    "@red-cup-engineering/code-http-cache-control-service": "0.1.1",
    "@red-cup-engineering/code-http-content-coding-service": "0.2.0",
    "@red-cup-engineering/code-http-cookie-service": "0.1.1",
    "@red-cup-engineering/code-http-date-service": "0.1.1",
    "@red-cup-engineering/code-server-sent-event-service": "0.1.1",
    "@red-cup-engineering/evaluate-http-conditional-request-service": "0.1.1",
    "@red-cup-engineering/form-http-response-representation-service": "0.1.1",
    "@red-cup-engineering/http-server-application-contract-service": "0.9.0",
    "@red-cup-engineering/negotiate-http-content-coding-service": "0.1.2",
    "@red-cup-engineering/negotiate-http-content-type-service": "0.1.1",
    "@red-cup-engineering/negotiate-http-language-service": "0.1.1",
    "@red-cup-engineering/publish-projected-events-service": "0.1.1",
    "@red-cup-engineering/serve-server-sent-events-service": "0.1.1",
    "@red-cup-engineering/sign-http-cookie-value-service": "0.1.1",
    "@red-cup-engineering/read-http-request-body-service": "0.2.2",
    "@red-cup-engineering/computer-data-engine": "0.11.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "eslint": "10.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.61.0"
  },
  "sideEffects": false
}
