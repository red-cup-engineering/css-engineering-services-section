{
  "name": "@red-cup-engineering/compose-http-application-service",
  "version": "0.1.1",
  "type": "module",
  "description": "Merge HTTP application descriptions and apply application transforms without routing requests or starting a listener.",
  "keywords": [
    "http",
    "web-server",
    "application",
    "composition"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./src/compose-http-application.d.mts",
      "import": "./src/compose-http-application.mjs"
    }
  },
  "files": [
    "src",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "check": "node --check src/compose-http-application.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@red-cup-engineering/http-server-application-contract-service": "0.1.1"
  },
  "sideEffects": false
}
