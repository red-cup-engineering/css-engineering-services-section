{
  "name": "@red-cup-engineering/resolve-edge-side-includes-service",
  "version": "0.1.1",
  "type": "module",
  "description": "Resolve Edge Side Includes and substitute request variables.",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/resolve-edge-side-includes.d.mts",
      "import": "./dist/resolve-edge-side-includes.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "npm run rebuild",
    "rebuild": "npm run clean && npm run build",
    "test": "node --test test/*.test.mts"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  },
  "sideEffects": false
}
