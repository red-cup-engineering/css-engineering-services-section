{
  "name": "@red-cup-engineering/http-platform-emulation-service",
  "version": "0.2.0",
  "type": "module",
  "description": "Storage, scheduling, feature flags, and web services composed with the shared web engine.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp/test-dist",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mts",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run rebuild",
    "rebuild": "npm run clean && npm run build"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./ab": {
      "types": "./dist/ab.d.mts",
      "import": "./dist/ab.mjs"
    },
    "./cache-api": {
      "types": "./dist/cache-api.d.mts",
      "import": "./dist/cache-api.mjs"
    },
    "./durable": {
      "types": "./dist/durable.d.mts",
      "import": "./dist/durable.mjs"
    },
    "./fetch": {
      "types": "./dist/fetch.d.mts",
      "import": "./dist/fetch.mjs"
    },
    "./flags": {
      "types": "./dist/flags.d.mts",
      "import": "./dist/flags.mjs"
    },
    "./fs-router": {
      "types": "./dist/fs-router.d.mts",
      "import": "./dist/fs-router.mjs"
    },
    "./geo": {
      "types": "./dist/geo.d.mts",
      "import": "./dist/geo.mjs"
    },
    "./kv": {
      "types": "./dist/kv.d.mts",
      "import": "./dist/kv.mjs"
    },
    "./object-store": {
      "types": "./dist/object-store.d.mts",
      "import": "./dist/object-store.mjs"
    },
    "./pages": {
      "types": "./dist/pages.d.mts",
      "import": "./dist/pages.mjs"
    },
    "./scheduler": {
      "types": "./dist/scheduler.d.mts",
      "import": "./dist/scheduler.mjs"
    },
    "./ws-pubsub": {
      "types": "./dist/ws-pubsub.d.mts",
      "import": "./dist/ws-pubsub.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@red-cup-engineering/code-http-cache-control-service": "0.1.1",
    "@red-cup-engineering/code-http-content-type-service": "0.1.1",
    "@red-cup-engineering/code-http-cookie-service": "0.1.1",
    "@red-cup-engineering/code-http-date-service": "0.1.1",
    "@red-cup-engineering/evaluate-http-conditional-request-service": "0.1.1",
    "@red-cup-engineering/http-edge-service": "0.1.0",
    "@red-cup-engineering/http-server-application-contract-service": "0.9.0",
    "@red-cup-engineering/read-http-request-body-service": "0.2.2",
    "@red-cup-engineering/sign-http-cookie-value-service": "0.1.1",
    "@red-cup-engineering/computer-data-engine": "0.11.2",
    "@red-cup-engineering/web-server-services-section": "0.5.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "eslint": "10.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.61.0",
    "@red-cup-engineering/web-server": "0.3.0"
  },
  "sideEffects": false
}
