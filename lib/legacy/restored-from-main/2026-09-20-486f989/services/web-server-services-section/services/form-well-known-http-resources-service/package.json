{
  "name": "@red-cup-engineering/form-well-known-http-resources-service",
  "version": "0.1.1",
  "type": "module",
  "description": "Form Web application resources beneath the HTTP well-known path.",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/form-well-known-http-resources.d.mts",
      "import": "./dist/form-well-known-http-resources.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "check": "tsc -p tsconfig.build.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test test/*.test.mts",
    "prepack": "npm run clean && npm run build"
  },
  "devDependencies": {"@types/node": "22.20.1", "typescript": "5.9.3"},
  "dependencies": {
    "@red-cup-engineering/http-server-application-contract-service": "0.1.1"
  },
  "sideEffects": false
}
