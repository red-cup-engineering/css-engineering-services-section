{
  "name": "@red-cup-engineering/read-http-request-body-service",
  "version": "0.2.2",
  "type": "module",
  "description": "Shared bounded HTTP body intake with native Node and portable Request bindings for bytes, text, JSON, and forms.",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/read-http-request-body.d.mts",
      "import": "./dist/read-http-request-body.mjs"
    },
    "./web": {
      "types": "./dist/web.d.mts",
      "import": "./dist/web.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "check": "tsc -p tsconfig.build.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test test/*.test.mts",
    "prepack": "npm run clean && npm run build"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3",
    "@red-cup-engineering/web-server-services-section": "0.5.0"
  },
  "dependencies": {
    "@red-cup-engineering/code-http-content-coding-service": "0.2.0",
    "@red-cup-engineering/code-http-content-type-service": "0.1.1",
    "@red-cup-engineering/code-http-multipart-form-data-service": "0.1.1"
  },
  "sideEffects": false
}
