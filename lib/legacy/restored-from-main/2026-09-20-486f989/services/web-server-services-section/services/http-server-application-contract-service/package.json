{
  "name": "@red-cup-engineering/http-server-application-contract-service",
  "version": "0.9.0",
  "type": "module",
  "description": "Shared type contract for Web applications, resources, request contexts, response representations, and HTTP server lifecycle handles; contains no server behavior.",
  "keywords": [
    "http",
    "web-server",
    "application-contract",
    "typescript"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run clean && npm run build"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json",
    "./web": {
      "types": "./dist/web.d.mts",
      "import": "./dist/web.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  },
  "sideEffects": false,
  "dependencies": {
    "@red-cup-engineering/read-http-request-body-service": "0.2.2",
    "@red-cup-engineering/computer-data-engine": "0.11.2",
    "@red-cup-engineering/computer-platform": "0.5.3"
  }
}
