{
  "name": "@red-cup-engineering/http-observability-service",
  "version": "0.0.3",
  "type": "module",
  "description": "Access logging, request metrics, and W3C trace-context propagation for @red-cup-engineering/http-server-core-service apps. A ready-made observability preset wires all three onto an app in one call.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp/test-dist",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run rebuild",
    "rebuild": "npm run clean && npm run build",
    "test": "node --test test/*.test.mts"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./access-log": {
      "types": "./dist/access-log.d.mts",
      "import": "./dist/access-log.mjs"
    },
    "./metrics": {
      "types": "./dist/metrics.d.mts",
      "import": "./dist/metrics.mjs"
    },
    "./preset": {
      "types": "./dist/preset.d.mts",
      "import": "./dist/preset.mjs"
    },
    "./trace": {
      "types": "./dist/trace.d.mts",
      "import": "./dist/trace.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@red-cup-engineering/http-server-application-contract-service": "0.9.0",
    "@red-cup-engineering/web-server-services-section": "0.5.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "eslint": "10.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.61.0"
  },
  "sideEffects": false
}
