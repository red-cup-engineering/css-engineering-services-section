{
  "name": "@red-cup-engineering/browser-site-conformance-service",
  "version": "0.1.0",
  "description": "Exercise deployed sites in representative browser profiles.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/browser-site-conformance.d.mts",
      "import": "./src/browser-site-conformance.mjs"
    }
  },
  "bin": {
    "conform-browser-site": "./scripts/conform-browser-site.mjs"
