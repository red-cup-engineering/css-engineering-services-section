    "check": "node --check src/browser-site-conformance.mjs && node --check scripts/conform-browser-site.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "playwright": ">=1.50 <2"
  },
  "peerDependenciesMeta": {
    "playwright": { "optional": true }
