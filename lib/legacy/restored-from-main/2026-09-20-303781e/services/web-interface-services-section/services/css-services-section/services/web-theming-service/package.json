{
  "name": "@red-cup-engineering/web-theming-service",
  "version": "0.0.4",
  "type": "module",
  "description": "Derives certified light/dark CSS custom-property palettes and a shared reset and component stylesheet from design tokens. Use when a site needs a themed CSS system rather than a hand-written stylesheet.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp/test-dist",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test test/*.test.mjs",
    "prepack": "npm run rebuild",
    "rebuild": "npm run clean && npm run build"
  },
  "main": "./src/index.mts",
  "types": "./src/index.mts",
  "files": [
    "dist",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./theming": {
      "types": "./dist/theming/index.d.mts",
      "import": "./dist/theming/index.mjs"
    },
    "./theming-computer": {
      "types": "./dist/theming-computer/index.d.mts",
      "import": "./dist/theming-computer/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@red-cup-engineering/html-structural-projection-service": "0.3.0",
    "@red-cup-engineering/agentic-knowledge-engine": "0.1.3",
    "@red-cup-engineering/agentic-relation-engine": "0.10.1",
    "@lenticule-science/articulating": "0.5.1"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  },
  "sideEffects": false
}
