{
  "name": "@red-cup-engineering/web-tufte-gui-services-section",
  "version": "0.12.0",
  "type": "module",
  "description": "Tiling User Form Topology Engine: a server-first web application framework with semantic tiling, forms, topology, and progressive enhancement.",
  "license": "MIT",
  "types": "./src/render-tufte-document.d.mts",
  "exports": {
    ".": {
      "types": "./src/render-tufte-document.d.mts",
      "import": "./src/render-tufte-document.mjs",
      "default": "./src/render-tufte-document.mjs"
    },
    "./browser": {
      "types": "./src/tufte-browser.d.mts",
      "import": "./src/tufte-browser.mjs",
      "default": "./src/tufte-browser.mjs"
    },
    "./topology": {
      "types": "./src/tufte-topology.d.mts",
      "import": "./src/tufte-topology.mjs",
      "default": "./src/tufte-topology.mjs"
    },
    "./theme": {
      "types": "./src/tufte-theme.d.mts",
      "import": "./src/tufte-theme.mjs",
      "default": "./src/tufte-theme.mjs"
    },
    "./application": {
      "types": "./src/tufte-application.d.mts",
      "import": "./src/tufte-application.mjs"
    },
    "./composition": {
      "types": "./src/tufte-composition.d.mts",
      "import": "./src/tufte-composition.mjs"
    },
    "./packet": {
      "types": "./src/tufte-packet.d.mts",
      "import": "./src/tufte-packet.mjs"
    },
    "./rendering": {
      "types": "./src/tufte-rendering.d.mts",
      "import": "./src/tufte-rendering.mjs"
    },
    "./storefront": {
      "types": "./src/tufte-storefront.d.mts",
      "import": "./src/tufte-storefront.mjs"
    },
    "./runtime": {
      "types": "./src/tufte-runtime.d.mts",
      "import": "./src/tufte-runtime.mjs"
    },
    "./storefront/application": {
      "types": "./src/tufte-storefront-application.d.mts",
      "import": "./src/tufte-storefront-application.mjs"
    }
  },
  "bin": {
    "render-tufte-document": "./scripts/render-tufte-document.mjs"
  },
  "files": [
    "src",
    "scripts",
    "examples",
    "docs",
    "content",
    "README.md",
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --project tsconfig.json",
    "test": "node --test test/*.test.mjs examples/head-to-head/test/*.test.mjs",
    "example": "node examples/head-to-head/server.mjs",
    "build": "node scripts/build-runtime-assets.mjs",
    "pretest": "npm run build",
    "prepack": "npm run build"
  },
  "keywords": [
    "server-rendering",
    "progressive-enhancement",
    "semantic-html",
    "tiles",
    "forms",
    "web-framework",
    "application-runtime",
    "topology",
    "layout-engine"
  ],
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "esbuild": "0.28.2",
    "playwright": "^1.62.1",
    "typescript": "5.9.3"
  },
  "sideEffects": false,
  "dependencies": {
    "@red-cup-engineering/html-structural-projection-service": "0.3.0",
    "@red-cup-engineering/read-http-request-body-service": "0.2.2",
    "@red-cup-engineering/web-server-services-section": "0.5.0"
  }
}
