@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <http://example.org/kb/> .

# SHACL shapes for constraint validation with severity levels

ex:StatementShape a sh:NodeShape ;
    sh:targetClass ex:Statement ;
    sh:property [
        sh:path ex:hasAuthor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class ex:Agent ;
        sh:severity sh:Violation ;
        sh:message "Statement must have exactly one author" ;
    ] ;
    sh:property [
        sh:path ex:hasConfidence ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0.0 ;
        sh:maxInclusive 1.0 ;
        sh:severity sh:Warning ;
        sh:message "Confidence should be between 0.0 and 1.0" ;
    ] ;
    sh:property [
        sh:path ex:createdAt ;
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
        sh:severity sh:Info ;
        sh:message "Statement should have a creation timestamp" ;
    ] .

ex:AgentShape a sh:NodeShape ;
    sh:targetClass ex:Agent ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "Agent must have a label" ;
    ] .
