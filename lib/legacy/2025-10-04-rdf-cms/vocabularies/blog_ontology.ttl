@prefix ex: <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:BlogPost a owl:Class ;
    rdfs:label "Blog Post"@en ;
    rdfs:comment "A blog post published on the web"@en .

ex:Author a owl:Class ;
    rdfs:label "Author"@en ;
    rdfs:comment "A person who writes blog posts"@en ;
    rdfs:subClassOf ex:Agent .

ex:Category a owl:Class ;
    rdfs:label "Category"@en ;
    rdfs:comment "A category for organizing blog posts"@en .

ex:hasTitle a owl:DatatypeProperty ;
    rdfs:label "has title"@en ;
    rdfs:domain ex:BlogPost ;
    rdfs:range xsd:string .

ex:hasContent a owl:DatatypeProperty ;
    rdfs:label "has content"@en ;
    rdfs:domain ex:BlogPost ;
    rdfs:range xsd:string .

ex:hasAuthor a owl:ObjectProperty ;
    rdfs:label "has author"@en ;
    rdfs:domain ex:BlogPost ;
    rdfs:range ex:Author .

ex:publishedAt a owl:DatatypeProperty ;
    rdfs:label "published at"@en ;
    rdfs:domain ex:BlogPost ;
    rdfs:range xsd:dateTime .

ex:hasCategory a owl:ObjectProperty ;
    rdfs:label "has category"@en ;
    rdfs:domain ex:BlogPost ;
    rdfs:range ex:Category .

ex:hasSlug a owl:DatatypeProperty ;
    rdfs:label "has slug"@en ;
    rdfs:comment "URL-friendly identifier"@en ;
    rdfs:domain ex:BlogPost ;
    rdfs:range xsd:string .

ex:isPublished a owl:DatatypeProperty ;
    rdfs:label "is published"@en ;
    rdfs:domain ex:BlogPost ;
    rdfs:range xsd:boolean .

ex:PublishedBlogPost a owl:Class ;
    rdfs:label "Published Blog Post"@en ;
    rdfs:comment "A blog post that has been published"@en ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty ex:isPublished ;
        owl:hasValue "true"^^xsd:boolean
    ] .
