@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <http://example.org/kb/> .

# Core domain ontology

ex:Expression a owl:Class ;
    rdfs:label "Expression" ;
    rdfs:comment "A statement or claim made by an agent" .

ex:Statement a owl:Class ;
    rdfs:label "Statement" ;
    rdfs:comment "A specific assertion or proposition" ;
    rdfs:subClassOf ex:Expression .

ex:Agent a owl:Class ;
    rdfs:label "Agent" ;
    rdfs:comment "An entity capable of making statements or performing actions" .

ex:Place a owl:Class ;
    rdfs:label "Place" ;
    rdfs:comment "A geographic or conceptual location" .

ex:hasAuthor a owl:ObjectProperty ;
    rdfs:label "has author" ;
    rdfs:domain ex:Expression ;
    rdfs:range ex:Agent .

ex:hasLocation a owl:ObjectProperty ;
    rdfs:label "has location" ;
    rdfs:domain ex:Expression ;
    rdfs:range ex:Place .

ex:hasConfidence a owl:DatatypeProperty ;
    rdfs:label "has confidence" ;
    rdfs:domain ex:Statement ;
    rdfs:range xsd:decimal .

ex:createdAt a owl:DatatypeProperty ;
    rdfs:label "created at" ;
    rdfs:range xsd:dateTime .
