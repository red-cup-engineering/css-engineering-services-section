{
  "name": "@emsenn/web-server",
  "version": "0.0.0",
  "type": "module",
  "description": "@emsenn/web-server — deployable web-tier services: a WebTics utterance-log service and an HTTP-to-Node-binary gateway that transports whole HTTP request/response carriers over stdio.",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "web-server": "./dist/cli.mjs"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp/test-dist",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.mjs",
    "serve": "pnpm run build && node dist/cli.mjs serve",
    "serve:gateway": "pnpm run build && node dist/cli.mjs gateway",
    "prepack": "pnpm run rebuild",
    "rebuild": "pnpm run clean && pnpm run build"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./service": {
      "types": "./dist/service.d.mts",
      "import": "./dist/service.mjs"
    },
    "./binary-gateway": {
      "types": "./dist/binary-gateway.d.mts",
      "import": "./dist/binary-gateway.mjs"
    },
    "./cli": {
      "types": "./dist/cli.d.mts",
      "import": "./dist/cli.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@emsenn/animating": "workspace:*",
    "@emsenn/computing": "workspace:*",
    "@emsenn/relating": "workspace:*",
    "@emsenn/http-server": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.4.1",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.61.0"
  },
  "sideEffects": false
}
