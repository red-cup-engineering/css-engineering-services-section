{
  "name": "@emsenn/organizing-with-email",
  "version": "0.0.0",
  "type": "module",
  "description": "Organizing with email - agentic operation of an email account by any OpenAI-compatible endpoint, with JSON-Schema carriers, relational IR identity actions, full RFC 5322/MIME composition and parsing, SMTP/IMAP/JMAP transport boundaries (FastMail-native), a pure email operation vocabulary, and autonomous mailbox tending.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp/test-dist",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && chmod +x dist/scripts/organizer.mjs",
    "test": "pnpm run rebuild && node --test test/*.test.mjs",
    "prepack": "pnpm run rebuild",
    "rebuild": "pnpm run clean && pnpm run build"
  },
  "bin": {
    "email-organizer": "./dist/scripts/organizer.mjs"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./holography": {
      "types": "./dist/holography.d.mts",
      "import": "./dist/holography.mjs"
    },
    "./messages": {
      "types": "./dist/messages.d.mts",
      "import": "./dist/messages.mjs"
    },
    "./transport": {
      "types": "./dist/transport.d.mts",
      "import": "./dist/transport.mjs"
    },
    "./smtp": {
      "types": "./dist/smtp.d.mts",
      "import": "./dist/smtp.mjs"
    },
    "./imap": {
      "types": "./dist/imap.d.mts",
      "import": "./dist/imap.mjs"
    },
    "./jmap": {
      "types": "./dist/jmap.d.mts",
      "import": "./dist/jmap.mjs"
    },
    "./operations": {
      "types": "./dist/operations.d.mts",
      "import": "./dist/operations.mjs"
    },
    "./algebra": {
      "types": "./dist/algebra/index.d.mts",
      "import": "./dist/algebra/index.mjs"
    },
    "./dispatch": {
      "types": "./dist/dispatch.d.mts",
      "import": "./dist/dispatch.mjs"
    },
    "./topology": {
      "types": "./dist/topology.d.mts",
      "import": "./dist/topology.mjs"
    },
    "./loop": {
      "types": "./dist/loop.d.mts",
      "import": "./dist/loop.mjs"
    },
    "./tending": {
      "types": "./dist/tending.d.mts",
      "import": "./dist/tending.mjs"
    },
    "./scripts/organizer": {
      "types": "./dist/scripts/organizer.d.mts",
      "import": "./dist/scripts/organizer.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@emsenn/animating": "0.0.0",
    "@emsenn/organizing-with-agents": "0.0.0",
    "@emsenn/organizing-with-llm-agents": "0.0.1",
    "@emsenn/organizing-with-openai-agents": "0.0.1",
    "@emsenn/relating": "0.0.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  },
  "sideEffects": false,
  "keywords": [
    "decommissioned"
  ]
}
